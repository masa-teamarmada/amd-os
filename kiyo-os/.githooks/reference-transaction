#!/bin/sh
# きよOS: ブランチの「作成」だけを拒否する hook。
#
# 理由: まさ・きよ・AI が別々の場所で動くため、枝が増えると
#       「どっちが本物か分からない」事故が起きる（AGENTS.common.md §5.1）。
#
# 削除と更新は通す。誤って作られた枝を畳めなくなると困るため。
# 例外的にどうしても必要なときは、環境変数で 1 回だけ外せる:
#   KIYO_OS_ALLOW_BRANCH=1 git switch -c <name>

[ "$1" = "prepared" ] || exit 0
[ "$KIYO_OS_ALLOW_BRANCH" = "1" ] && exit 0

zero='0000000000000000000000000000000000000000'

while read -r old new ref; do
  case "$ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  # 作成 = 旧値が全ゼロ
  [ "$old" != "$zero" ] && continue

  # main だけは作成を許す（clone 直後など）
  [ "$ref" = "refs/heads/main" ] && continue

  echo "" >&2
  echo "🚫 きよOS はブランチを作りません（main 一本）。" >&2
  echo "   作ろうとした枝: ${ref#refs/heads/}" >&2
  echo "   main に直接 commit して push してください。" >&2
  echo "   詳しくは AGENTS.common.md の「5.1 main 一本」を見てください。" >&2
  echo "" >&2
  exit 1
done

exit 0
