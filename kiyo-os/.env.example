# きよOS の環境変数のひな形。
#
# 使い方: このファイルを .env.local という名前でコピーして、値を入れる。
#   cp .env.example .env.local
#
# 【重要】.env.local は git に入りません。値をここ（.env.example）に書かないこと。
# 実際の値は Supabase / Vercel の管理画面から取ってくる。

# --- Supabase（まだ未作成。空のままで大丈夫です）---
# 空のままだと、アプリはダミーデータで動きます。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE_ROLE_KEY はこのファイルにも .env.local にも書かない。
# サーバー側で必要になったら、Vercel の Environment Variables にだけ設定する。
