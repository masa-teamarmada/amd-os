    },
    {
      "path": "/api/cron/freee-member-payout-sync",
      "schedule": "12 0 * * *"
    },
    {
      "path": "/api/cron/payment-obligations",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/payment-confirm-nudges",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/payout-reward-cache-refresh",
      "schedule": "5 18 * * *"
    },
    {
      "path": "/api/cron/payout-notice-prebuild",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/contract-billing-auto-confirm",
      "schedule": "0 22 1 * *"
    },
    {
      "path": "/api/cron/freee-accounting-weekly",
      "schedule": "0 1 * * 4"
    },
    {
      "path": "/api/cron/reimbursement-reminders",
      "schedule": "0 1 * * *"
    }
  ]
}
