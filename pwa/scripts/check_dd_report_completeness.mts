import fs from 'node:fs/promises';import path from 'node:path';import assert from 'node:assert/strict';import {createElement}from'react';import{renderToStaticMarkup}from'react-dom/server';
import{splitDdDevelopmentChapters}from'../src/lib/dd-report-development-plans.ts';import{DdReportContent}from'../src/components/dd/report/DdReportContent.tsx';import type{DdReportChapter}from'../src/lib/dd-report-types.ts';
const [sourceDir,manifestFile,coverageFile]=process.argv.slice(2);if(!sourceDir||!manifestFile||!coverageFile)throw Error('Source folder and current manifest required');
const source=JSON.parse(await fs.readFile(path.join(sourceDir,'manifest.json'),'utf8')),current=JSON.parse(await fs.readFile(manifestFile,'utf8')),chapters=splitDdDevelopmentChapters(current.chapters as DdReportChapter[]),coverage=JSON.parse(await fs.readFile(coverageFile,'utf8'));
assert.equal(coverage.entries.length,38);assert.equal(coverage.sourceSha256,source.sourceSha256);assert.equal(coverage.unexplainedMissing,0);let checked=0,figures=0;
for(const old of source.chapters as DdReportChapter[]){const e=coverage.entries.find((x:{slug:string})=>x.slug===old.slug)!;assert(e,'Every source worksheet appears');const cells=old.body.rows.flatMap(r=>r.cells).filter(c=>c.value!==null&&c.value!=='');assert.equal(e.sourceCells,cells.length);assert.equal(e.sameAddress+e.relocated+e.removed,e.sourceCells);assert.equal(e.sourceFigures,old.body.objects.length);figures+=e.sourceFigures;checked+=e.sourceCells;for(const target of e.targets??[e.slug])assert(chapters.some(c=>c.slug===target));for(const sheet of e.excel)assert(sheet==='資料一覧'||chapters.some(c=>(c.slug.endsWith('-development-plan')?c.title:c.source_sheet.replace('損益・資金繰','資金繰表'))===sheet&&c.body.excel?.mode!=='pdf'));}
assert.equal(checked,coverage.sourceCells);assert.equal(figures,59);
const tech=chapters.find(c=>c.slug==='technical-development-plan')!,d=tech.body.dependencies!;assert.equal(d.nodes.length,5);assert.deepEqual(d.edges.map(e=>e.from+'-'+e.to).sort(),['1-2','1-4','2-3','2-5','3-5','4-5']);for(const n of d.nodes)assert(n.pass&&n.deliverable);assert(d.approval.includes('①＋②、金属製品は①＋②＋③、燃料製品は①＋④'));
for(const pdf of [false,true]){const html=renderToStaticMarkup(createElement(DdReportContent,{chapter:tech,slug:'sol',index:chapters,allRows:pdf}));assert.equal((html.match(/data-dependency=/g)??[]).length,6);for(const n of d.nodes)assert(html.includes(n.deliverable));const matrix=renderToStaticMarkup(createElement(DdReportContent,{chapter:chapters.find(c=>c.slug==='disclosure-index')!,slug:'sol',index:chapters,allRows:pdf}));assert(!matrix.includes('data-coverage-sheet'));assert(!matrix.includes('元Excelから、OS・配布ファイルへの掲載対応'));assert(!html.includes('月額50万円'));assert(!('coverage'in chapters.find(c=>c.slug==='disclosure-index')!.body));assert(!matrix.includes('<details'));}
console.log(JSON.stringify({sourceSheets:38,readerPages:chapters.length,sourceContentCells:checked,sourceFigures:figures,dependencyFields:5,dependencyArrows:6,unexplainedMissing:0,webAndPdfRender:'PASS'}));
