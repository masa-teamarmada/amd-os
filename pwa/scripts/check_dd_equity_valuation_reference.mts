import assert from 'node:assert/strict';
import {createElement} from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import {ddEquityValuations} from '../src/lib/dd-report-valuations.ts';
import {DdEquityValuationChart,ddEquityValuationSteps} from '../src/components/dd/report/DdEquityValuationChart.tsx';
const capital:Record<string,number>={C97:2,C98:3,C99:7,C100:15,C101:30,C102:100,I29:14,I30:17,L29:27.5,L30:34.5,O29:86.25,O30:101.25,R29:270,R30:300,U29:900,U30:1000};
let cap:number|null=1e9;
const read=(sheet:string,address:string)=>sheet==='共通前提'&&address==='C16'?cap:sheet==='資本政策表'?capital[address]:null;
let rounds=ddEquityValuations(read);
assert.equal(rounds[0].post,null,'J-KISS retains no confirmed seed post valuation');
const seed=ddEquityValuationSteps(rounds[0]);
assert.equal(seed[1].from,10);assert.equal(seed[1].to,12,'seed funding ends above the reference cap');
const markup=renderToStaticMarkup(createElement(DdEquityValuationChart,{round:rounds[0]}));
const rects=[...markup.matchAll(/<rect[^>]* y="([^"]+)"[^>]* height="([^"]+)"/g)].map(m=>({y:Number(m[1]),height:Number(m[2])}));
assert.equal(rects.length,2);assert(rects[1].y<rects[0].y,'funding is visibly above the reference');assert(Math.abs(rects[1].y+rects[1].height-rects[0].y)<1e-8);
assert.equal(rounds[1].previousPost,null);assert.equal(rounds[1].previousCap,10);assert.equal(rounds[1].progress,2);
const a=ddEquityValuationSteps(rounds[1]);assert.equal(rounds[1].seedConversion,2);assert.equal(a.length,5);assert(a[0].reference);assert.deepEqual(a.slice(1,4).map(s=>[s.from,s.to,s.amount]),[[10,12,2],[12,14,2],[14,17,3]]);
assert.equal(rounds[1].previousCap!+rounds[1].progress!+rounds[1].seedConversion!,rounds[1].pre);
assert.equal(rounds[1].pre!+rounds[1].funding!,rounds[1].post);
assert.equal(a.filter(s=>s.label.includes('転換元本')).length,1,'seed principal is counted exactly once at A');
assert.equal(a[3].amount,3,'A new cash remains 3, excluding seed cash received earlier');
assert.deepEqual(rounds.slice(2).map(r=>r.progress),[10.5,51.75,168.75,600]);
for(const r of rounds.slice(2))assert.equal(r.previousPost!+r.progress!+r.funding!,r.post);
capital.I29=10;capital.I30=13;rounds=ddEquityValuations(read);assert.equal(rounds[1].progress,-2);assert(ddEquityValuationSteps(rounds[1])[1].label.includes('評価減'));
Object.assign(capital,{I29:14,I30:17});cap=1.2e9;assert.equal(ddEquityValuations(read)[1].progress,0,'a zero increment is shown honestly');
cap=null;rounds=ddEquityValuations(read);assert.equal(rounds[1].progress,null);const fallback=ddEquityValuationSteps(rounds[1]);assert.equal(fallback.length,4,'missing cap preserves the separate conversion step');assert.deepEqual(fallback.map(s=>[s.from,s.to]),[[0,12],[12,14],[14,17],[0,17]]);
cap=1e9;capital.C97=3;assert.equal(ddEquityValuations(read)[1].progress,1,'principal changes cannot be counted again as progress');
console.log('PASS: seed funding stacked above cap / A cap 10 + progress 2 + conversion principal 2 + new cash 3 = post 17 / no invented post valuation / downstream reconciliation / down and zero increments / missing reference');
