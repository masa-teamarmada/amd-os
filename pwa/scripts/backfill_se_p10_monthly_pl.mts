const rows: Row[] = SOURCE_ROWS.map((r) => ({ project_id: PROJECT_ID, ...r }));

const db = createClient(env("NEXT_PUBLIC_SUPABASE_URL") ?? "", env("SUPABASE_SERVICE_ROLE_KEY") ?? "", { auth: { persistSession: false, autoRefreshToken: false } });
const { data: oldRows, error: readError } = await db.from("project_pl_monthly").select("ym, revenue_yen, cogs_yen, personnel_yen, rd_yen, marketing_yen, other_opex_yen, notes").eq("project_id", PROJECT_ID).order("ym");
if (readError) throw readError;
const key = (r: Omit<Row, "project_id">) => JSON.stringify([r.ym, r.revenue_yen, r.cogs_yen, r.personnel_yen, r.rd_yen, r.marketing_yen, r.other_opex_yen, r.notes]);
const same = (a: Array<Omit<Row, "project_id">>, b: Row[]) => a.length === b.length && a.every((r, i) => key(r) === key(b[i]));
const annual = (fyStart: number) => rows.filter((r) => r.ym >= `${fyStart}-04` && r.ym <= `${fyStart + 1}-03`).reduce((s, r) => s + r.revenue_yen - r.cogs_yen - r.personnel_yen - r.rd_yen - r.marketing_yen - r.other_opex_yen, 0);
console.log(JSON.stringify({ mode: apply ? "apply" : "dry-run", rowCount: rows.length, span: [rows[0].ym, rows[rows.length - 1].ym], existingCount: (oldRows ?? []).length, exactExisting: same(oldRows ?? [], rows), operatingProfitByFY: Object.fromEntries([2021, 2022, 2023, 2024, 2025, 2026].map((y) => [`FY${y - 2000}`, annual(y)])) }));
if (apply && !same(oldRows ?? [], rows)) {
  const { error: writeError } = await db.from("project_pl_monthly").upsert(rows, { onConflict: "project_id,ym" }); if (writeError) throw writeError;
  console.log(JSON.stringify({ written: rows.length }));
}
