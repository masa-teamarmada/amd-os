for(const [value,format,expected] of golden)assert.equal(formatDdReportValue(value,format),expected,`${format} ${value}`);
const formatSource=readFileSync(new URL('../src/lib/dd-report-format.ts',import.meta.url),'utf8');
assert.ok(!/\.toLocaleString\(/.test(formatSource.replace(/\/\/.*$/gm,'')),'数値の表示で toLocaleString を呼ばない（呼ぶたびに数値書式を作り直す）');
const started=performance.now();for(let i=0;i<50000;i++)formatDdReportValue(1234567.891+i,'#,##0');
assert.ok(performance.now()-started<1500,'5万セルの表示形式は1.5秒未満');
// 2) DDの章リンク・前後リンク・旧資料/添付・設定/編集のリンクは先読みしない。見えているリンクを先読みすると、
//    1回の移動でDDページのサーバ描画が3〜4回走っていた。
const read=(p:string)=>readFileSync(new URL('../'+p,import.meta.url),'utf8');
const nav=read('src/components/dd/report/DdReportNavigation.tsx'),reader=read('src/components/dd/report/DdReportReader.tsx'),shell=read('src/components/dd/DdViewerShell.tsx');
for(const [name,source] of [['DdReportNavigation',nav],['DdReportReader',reader],['DdViewerShell',shell]] as const){
  const links=[...source.matchAll(/<Link\b[^>]*>/g)].map(m=>m[0]);
  assert.ok(links.length>0,name);
  for(const link of links)assert.ok(link.includes('prefetch={false}'),`${name} のリンクは先読みしない: ${link.slice(0,80)}`);
}
// 3) PJの領域切替（コックピット/ワークスペース/DD）は開くたびに先読みせず、hover/focusだけで先読みする。
const surfaceNav=read('src/components/nav/ProjectSurfaceNav.tsx');
assert.match(surfaceNav,/<Link key=\{surface\.key\} href=\{surface\.href\} prefetch=\{false\}/,'領域切替は表示時に先読みしない');
assert.match(surfaceNav,/onMouseEnter=\{current === surface\.key \? undefined : \(\) => router\.prefetch\(surface\.href\)\}/,'hoverで他領域を先読みする');
assert.match(surfaceNav,/onFocus=\{current === surface\.key \? undefined : \(\) => router\.prefetch\(surface\.href\)\}/,'focusで他領域を先読みする');
console.log('DD表示コスト: 表示形式の使い回しと結果一致・リンク先読み停止 PASS');
