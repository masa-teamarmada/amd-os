import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import { createDdReferenceCache } from "../src/lib/dd-reference-cache.ts";

let time = 0, reads = 0;
const cache = createDdReferenceCache<number>({ ttlMs: 30, maxEntries: 2, now: () => time });
const load = async () => ++reads;
assert.deepEqual(await Promise.all(Array.from({ length: 8 }, () => cache.load("pj:company", load))), Array(8).fill(1));
time = 29;
assert.equal(await cache.load("pj:company", load), 1);
time = 30;
assert.equal(await cache.load("pj:company", load), 2, "TTL expires without serving stale data");
assert.equal(await cache.load("pj:company", load, true), 3, "explicit refresh bypasses cached data");
assert.equal(await cache.load("other:company", load), 4, "projects have independent cache keys");
assert.equal(await cache.load("pj:cost", load), 5, "pages have independent cache keys");
assert.equal(await cache.load("pj:company", load), 6, "bounded cache evicts oldest entry");
await assert.rejects(cache.load("failure", async () => { throw new Error("offline"); }));
assert.equal(await cache.load("failure", load), 7, "failed loads are retried");
let resolveOld!: (value: number) => void;
const pending = cache.load("race", () => new Promise<number>(resolve => { resolveOld = resolve; }));
await Promise.resolve();
assert.equal(await cache.load("race", async () => 99, true), 99);
resolveOld(10); await pending;
assert.equal(await cache.load("race", load), 99, "older inflight result cannot replace refreshed data");
const loader = readFileSync("src/lib/dd-project-pages-server.ts", "utf8");
assert.match(loader, /JSON.stringify\(\[projectId, page\]\)/);
assert.ok(loader.indexOf("redactProjectPartnerNames(content, hidden)") > loader.indexOf("pageCache.load("), "disclosure policy is applied after cache lookup");
assert.match(loader, /loadProjectPartnerDisclosure\(createAdminClient\(\), projectId\)/, "non-disclosure rules are freshly checked");
for (const key of ["technology", "technical-evidence", "contracts", "governance", "partners", "activity", "short-term-plan", "long-term-plan"]) assert.ok(loader.match(/const uncachedPages[^;]+/)?.[0].includes(`"${key}"`), `${key} keeps live disclosure checks`);
const page = readFileSync("src/app/dd/[slug]/page.tsx", "utf8");
assert.ok(page.indexOf("resolveDdPackageAccess(") < page.indexOf("loadDdProjectPage("), "authorization precedes cache access");
assert.match(page, /fresh === "1"/);
console.log("DD reference cache: single-flight, TTL, fresh, isolation, bounded memory, failures, race and authorization boundary PASS");
